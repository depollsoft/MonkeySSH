#!/bin/bash
# Pre-push hook for Flutty
# Install via scripts/setup.sh or copy into "$(git rev-parse --git-path hooks)".

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)

cd "$REPO_ROOT"

echo 'Running pre-push checks...'

# Analyze only the Dart files actually being pushed, and skip the analyzer
# entirely when the push carries none. A push often has no Dart changes at all
# (a Go-only change under remote/monkeymux, a docs edit), and running a
# whole-repo analysis for those is both slow and, in a fresh worktree that has
# never had `flutter pub get`, guaranteed to fail: --no-pub leaves every
# package import unresolved, so every Flutter symbol reads as undefined and the
# analyzer reports tens of thousands of spurious errors. This mirrors the
# pre-commit hook, which scopes its analysis to the staged Dart files. CI still
# runs the full analysis and test suite.

is_zero_sha() {
    # A deleted or not-yet-created ref is reported as an all-zero object id
    # (40 hex zeros for SHA-1, 64 for SHA-256).
    case "$1" in
        '' | *[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

# The empty-tree object id, used as the diff base for a pushed branch whose
# oldest new commit is a root commit (no parent to diff against).
EMPTY_TREE=$(git hash-object -t tree /dev/null)

# Reads the ref update lines git feeds on stdin and prints, one per line, every
# Dart file that still exists at each pushed tip. Uses a net diff against the
# push's base rather than a per-commit union, so a file added or edited in an
# earlier commit and then deleted later in the same push is not analyzed: it no
# longer exists at the tip and `flutter analyze` rejects a nonexistent path.
collect_pushed_dart_files() {
    local local_ref local_sha remote_ref remote_sha base oldest
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -z "${local_ref:-}" ] && continue
        if is_zero_sha "$local_sha"; then
            continue # Branch deletion: nothing to analyze.
        fi
        if is_zero_sha "$remote_sha"; then
            # New branch on the remote: base the diff on the parent of the
            # oldest commit not yet on any remote ref (the fork point), or the
            # empty tree when that commit is a repository root.
            oldest=$(git rev-list --reverse --topo-order "$local_sha" \
                --not --remotes 2>/dev/null | head -n 1 || true)
            [ -z "$oldest" ] && continue # Nothing new to push on this ref.
            base=$(git rev-parse --verify --quiet "${oldest}^" || echo "$EMPTY_TREE")
        else
            base="$remote_sha"
        fi
        git diff --name-only --diff-filter=ACM "$base" "$local_sha" -- '*.dart'
    done
}

dart_files=()
while IFS= read -r file; do
    [ -z "$file" ] && continue
    # analysis_options.yaml excludes third_party/**, where vendored upstream
    # code keeps its own lint rules; honour that here too.
    case "$file" in
        third_party/*) continue ;;
    esac
    dart_files+=("$file")
done < <(collect_pushed_dart_files | sort -u)

if [ "${#dart_files[@]}" -eq 0 ]; then
    echo 'No pushed Dart files; skipping analyzer.'
    echo 'Pre-push checks passed!'
    exit 0
fi

echo "Running analyzer on ${#dart_files[@]} pushed Dart file(s)..."
flutter analyze --fatal-warnings --fatal-infos --no-pub -- "${dart_files[@]}"

echo 'Skipping full test suite in pre-push; run targeted tests for changed behavior locally.'
echo 'CI runs the full test suite.'

echo 'Pre-push checks passed!'
