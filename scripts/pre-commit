#!/bin/bash
# Pre-commit hook for Flutty
# Install via scripts/setup.sh or copy into "$(git rev-parse --git-path hooks)".

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)

cd "$REPO_ROOT"

echo 'Running pre-commit checks...'

# analysis_options.yaml excludes third_party/**, where vendored upstream code
# keeps its own lint rules. Honour that here too, or vendoring anything with
# Dart sources becomes uncommittable.
staged_dart_files=()
while IFS= read -r file; do
    staged_dart_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.dart' ':(exclude)third_party/')

if [ "${#staged_dart_files[@]}" -eq 0 ]; then
    echo 'No staged Dart files; skipping Dart checks.'
    echo 'Pre-commit checks passed!'
    exit 0
fi

echo 'Checking formatting...'
dart format --output=none --set-exit-if-changed -- "${staged_dart_files[@]}"

echo 'Running analyzer on staged Dart files...'
flutter analyze --fatal-warnings --fatal-infos --no-pub -- "${staged_dart_files[@]}"

echo 'Skipping tests in pre-commit; run targeted tests for changed behavior before pushing.'
echo 'Pre-commit checks passed!'
