default_platform(:ios)

require 'fileutils'
require 'shellwords'
require 'tmpdir'
require_relative '../../scripts/preview_release_notes'
require_relative '../../scripts/store_metadata'
require_relative '../../scripts/testflight_delivery'
require_relative '../../scripts/match_git_persistence'

platform :ios do
  before_all do
    setup_ci if ENV['CI'] && RUBY_PLATFORM.include?('darwin')
  end

  APP_IDS = {
    'Private' => 'xyz.depollsoft.monkeyssh.private',
    'Production' => 'xyz.depollsoft.monkeyssh',
  }.freeze

  LIVE_ACTIVITY_APP_IDS = {
    'Private' => 'xyz.depollsoft.monkeyssh.private.ConnectionStatusLiveActivity',
    'Production' => 'xyz.depollsoft.monkeyssh.ConnectionStatusLiveActivity',
  }.freeze

  METADATA_DIRS = {
    'xyz.depollsoft.monkeyssh.private' => './fastlane/metadata-private',
    'xyz.depollsoft.monkeyssh' => './fastlane/metadata-production',
  }.freeze

  SCREENSHOTS_PATH = './fastlane/screenshots'.freeze
  APP_PREVIEWS_PATH = './fastlane/app-previews'.freeze

  TEAM_ID = '43AWMS3YJX'.freeze

  private_lane :get_api_key do
    app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY_CONTENT'],
      is_key_content_base64: false,
    )
  end

  private_lane :patch_deliver_review_attachment_fetch do
    begin
      require 'deliver/upload_metadata'
    rescue LoadError => e
      UI.important("Could not load Fastlane upload metadata patch target: #{e.message}")
      next
    end

    unless defined?(Deliver::UploadMetadata) &&
           Deliver::UploadMetadata.private_method_defined?(:review_attachment_file)
      UI.important(
        'Fastlane Deliver::UploadMetadata#review_attachment_file was not found; ' \
        'skipping MonkeySSH review attachment patch.',
      )
      next
    end

    next if Deliver::UploadMetadata.private_method_defined?(
      :monkeyssh_original_review_attachment_file,
    )

    Deliver::UploadMetadata.class_eval do
      alias_method :monkeyssh_original_review_attachment_file,
                   :review_attachment_file

      def review_attachment_file(version)
        # Fastlane fetches review details even when there is no attachment to sync,
        # which can abort before screenshots upload on first-version app records.
        return if options[:app_review_attachment_file].to_s.empty?

        monkeyssh_original_review_attachment_file(version)
      end

      private :review_attachment_file,
              :monkeyssh_original_review_attachment_file
    end
  end

  private_lane :patch_deliver_review_information_sync do
    begin
      require 'deliver/upload_metadata'
    rescue LoadError => e
      UI.important("Could not load Fastlane upload metadata patch target: #{e.message}")
      next
    end

    unless defined?(Deliver::UploadMetadata) &&
           Deliver::UploadMetadata.private_method_defined?(:review_information)
      UI.important(
        'Fastlane Deliver::UploadMetadata#review_information was not found; ' \
        'skipping MonkeySSH review information patch.',
      )
      next
    end

    next if Deliver::UploadMetadata.private_method_defined?(
      :monkeyssh_original_review_information,
    )

    Deliver::UploadMetadata.class_eval do
      alias_method :monkeyssh_original_review_information,
                   :review_information

      def review_information(version)
        info = options[:app_review_information]
        unless info.nil? || info.empty?
          normalized = info.transform_keys(&:to_sym)
          required_contact_keys = %i[
            first_name
            last_name
            phone_number
            email_address
          ]
          missing = required_contact_keys.select do |key|
            normalized[key].to_s.strip.empty?
          end
          # App Store Connect rejects a review-detail update unless every
          # contact attribute is present, so syncing reviewer notes alone
          # (e.g. review_information/notes.txt without contact secrets) fails.
          # Skip the update instead of aborting the whole metadata sync.
          unless missing.empty?
            UI.important(
              'Skipping App Store review information sync because required ' \
              "App Review contact fields are missing: #{missing.join(', ')}. " \
              'Set the APP_REVIEW_CONTACT_* environment variables to sync ' \
              'reviewer notes.',
            )
            return
          end
        end

        monkeyssh_original_review_information(version)
      end

      private :review_information,
              :monkeyssh_original_review_information
    end
  end

  private_lane :patch_app_store_ready_for_review_lookup do
    begin
      require 'spaceship/connect_api/models/app'
    rescue LoadError => e
      UI.user_error!("Could not load App Store version lookup patch: #{e.message}")
    end

    app_class = Spaceship::ConnectAPI::App
    unless app_class.method_defined?(:get_edit_app_store_version)
      UI.user_error!(
        'Fastlane App#get_edit_app_store_version was not found.',
      )
    end

    next if app_class.method_defined?(
      :monkeyssh_original_get_edit_app_store_version,
    )

    app_class.class_eval do
      alias_method :monkeyssh_original_get_edit_app_store_version,
                   :get_edit_app_store_version

      def get_edit_app_store_version(
        client: nil,
        platform: nil,
        includes: Spaceship::ConnectAPI::AppStoreVersion::ESSENTIAL_INCLUDES
      )
        client ||= Spaceship::ConnectAPI
        platform ||= Spaceship::ConnectAPI::Platform::IOS
        current = monkeyssh_original_get_edit_app_store_version(
          client: client,
          platform: platform,
          includes: includes,
        )
        ready = get_app_store_versions(
          client: client,
          filter: {
            appVersionState:
              Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::READY_FOR_REVIEW,
            platform: platform,
          },
          includes: includes,
        ).max_by { |version| Gem::Version.new(version.version_string) }

        [current, ready]
          .compact
          .max_by { |version| Gem::Version.new(version.version_string) }
      end
    end
  end

  desc 'Sync certificates and profiles for a given type and app identifier'
  private_lane :check_match_persistence do
    require 'match'
    storage = Match::Storage::GitStorage
    storage.prepend(MatchGitPersistence) unless storage.ancestors.include?(MatchGitPersistence)
  end

  private_lane :sync_certs do |options|
    app_id = options[:app_identifier]
    match_type = options[:type] || 'appstore'
    readonly = options.key?(:readonly) ? options[:readonly] : true
    force = options[:force] == true

    api_key = get_api_key
    check_match_persistence unless readonly

    write_credentials = {}
    unless readonly || ENV['MATCH_GIT_WRITE_BASIC_AUTHORIZATION'].to_s.empty?
      write_credentials[:git_basic_authorization] = ENV.fetch('MATCH_GIT_WRITE_BASIC_AUTHORIZATION')
    end

    match(
      **write_credentials,
      type: match_type,
      app_identifier: app_id,
      api_key: api_key,
      readonly: readonly,
      force: force,
      # Ad hoc profiles embed the registered device list, so a profile minted
      # before a tester registered their device cannot install on it. Let match
      # regenerate when the device count changes; App Store profiles have no
      # device list and ignore this.
      force_for_new_devices: match_type == 'adhoc' && !readonly,
    )
  end

  private_lane :build_and_sign do |options|
    scheme = options[:scheme]
    export_method = options[:export_method] || 'app-store'
    match_type = export_method == 'ad-hoc' ? 'adhoc' : 'appstore'
    match_profile_prefix = export_method == 'ad-hoc' ? 'AdHoc' : 'AppStore'
    app_id = APP_IDS[scheme]
    live_activity_app_id = LIVE_ACTIVITY_APP_IDS[scheme]

    sync_certs(
      app_identifier: [app_id, live_activity_app_id],
      type: match_type,
      readonly: match_type == 'appstore',
    )

    profile_name = ENV["sigh_#{app_id}_#{match_type}_profile-name"] ||
                   ENV["sigh_#{app_id}_#{match_type}_profile_name"] ||
                   "match #{match_profile_prefix} #{app_id}"
    live_activity_profile_name =
      ENV["sigh_#{live_activity_app_id}_#{match_type}_profile-name"] ||
      ENV["sigh_#{live_activity_app_id}_#{match_type}_profile_name"] ||
      "match #{match_profile_prefix} #{live_activity_app_id}"

    update_code_signing_settings(
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: 'Apple Distribution',
      profile_name: profile_name,
      bundle_identifier: app_id,
      path: 'Runner.xcodeproj',
      targets: ['Runner'],
      build_configurations: ["Release-#{scheme}"],
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: 'Apple Distribution',
      profile_name: live_activity_profile_name,
      bundle_identifier: live_activity_app_id,
      path: 'Runner.xcodeproj',
      targets: ['ConnectionStatusLiveActivityExtension'],
      build_configurations: ["Release-#{scheme}"],
    )

    build_app(
      workspace: 'Runner.xcworkspace',
      scheme: scheme,
      configuration: "Release-#{scheme}",
      export_method: export_method,
      output_directory: '../build/ios/ipa',
      archive_path: '../build/ios/archive/Runner.xcarchive',
      xcargs: "DEVELOPMENT_TEAM=#{TEAM_ID}",
    )
  end

  private_lane :resolved_ipa_path do |options|
    provided_ipa_path = options[:ipa_path].to_s
    provided_ipa_path.empty? ? lane_context[SharedValues::IPA_OUTPUT_PATH] : provided_ipa_path
  end

  private_lane :testflight_release_notes do
    preview_notes = PreviewReleaseNotes.current(max_length: 4000)
    next [nil, nil] if preview_notes.nil?

    [
      preview_notes,
      {
        'en-US' => {
          whats_new: preview_notes,
        },
      },
    ]
  end

  private_lane :firebase_release_notes do
    notes = ENV['FLUTTY_DISTRIBUTION_RELEASE_NOTES'].to_s.strip
    notes.empty? ? PreviewReleaseNotes.current(max_length: 16_000) : notes
  end

  private_lane :resolved_profile_path do |options|
    app_id = options[:app_identifier]
    match_type = options[:type] || 'appstore'
    profile_path = ENV["sigh_#{app_id}_#{match_type}_profile-path"] ||
                   ENV["sigh_#{app_id}_#{match_type}_profile_path"]

    UI.user_error!("Missing installed provisioning profile path for #{app_id}") if profile_path.to_s.empty?
    UI.user_error!("Provisioning profile not found at #{profile_path} for #{app_id}") unless File.exist?(profile_path)

    profile_path
  end

  private_lane :resolved_certificate_name do |options|
    app_id = options[:app_identifier]
    match_type = options[:type] || 'appstore'
    certificate_name = ENV["sigh_#{app_id}_#{match_type}_certificate-name"] ||
                       ENV["sigh_#{app_id}_#{match_type}_certificate_name"]

    UI.user_error!("Missing installed certificate name for #{app_id}") if certificate_name.to_s.empty?

    certificate_name
  end

  private_lane :extract_profile_entitlements do |options|
    profile_path = options[:profile_path]
    output_path = options[:output_path]

    sh(
      "security cms -D -i #{profile_path.shellescape} | " \
      "plutil -extract Entitlements xml1 -o #{output_path.shellescape} -",
    )

    output_path
  end

  private_lane :bundle_executable_path do |options|
    bundle_path = options[:bundle_path]
    info_plist_path = File.join(bundle_path, 'Info.plist')
    UI.user_error!("Info.plist not found at #{info_plist_path}") unless File.exist?(info_plist_path)

    executable_name = sh(
      "/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' #{info_plist_path.shellescape}",
      log: false,
    ).strip
    executable_path = File.join(bundle_path, executable_name)
    UI.user_error!("Bundle executable not found at #{executable_path}") unless File.exist?(executable_path)

    executable_path
  end

  private_lane :embed_swift_runtime do |options|
    bundle_path = options[:bundle_path]
    frameworks_path = File.join(bundle_path, 'Frameworks')
    FileUtils.mkdir_p(frameworks_path)

    command = [
      'xcrun',
      'swift-stdlib-tool',
      '--copy',
      '--platform',
      'iphoneos',
      '--destination',
      frameworks_path,
      '--scan-executable',
      bundle_executable_path(bundle_path: bundle_path),
      '--scan-folder',
      frameworks_path,
    ]
    sh(command.map(&:shellescape).join(' '))
  end

  private_lane :populate_swift_support do |options|
    app_path = options[:app_path]
    package_root = options[:package_root]
    swift_support_dir = File.join(package_root, 'SwiftSupport', 'iphoneos')
    appex_paths = Dir[File.join(app_path, 'PlugIns', '*.appex')].sort

    embed_swift_runtime(bundle_path: app_path)
    appex_paths.each do |appex_path|
      FileUtils.rm_rf(File.join(appex_path, 'Frameworks'))
    end

    FileUtils.rm_rf(File.join(package_root, 'SwiftSupport'))
    FileUtils.mkdir_p(swift_support_dir)

    swift_runtime_paths = Dir[File.join(app_path, 'Frameworks', 'libswift*.dylib')].sort

    swift_runtime_paths
      .uniq { |path| File.basename(path) }
      .each do |runtime_path|
        FileUtils.cp(runtime_path, File.join(swift_support_dir, File.basename(runtime_path)))
      end

    unless Dir.glob(File.join(swift_support_dir, '*')).any?
      UI.message('No Swift runtime libraries detected; removing empty SwiftSupport directory.')
      FileUtils.rm_rf(File.join(package_root, 'SwiftSupport'))
    end
  end

  private_lane :codesign_path do |options|
    path = options[:path]
    signing_identity = options[:signing_identity]
    entitlements_path = options[:entitlements_path].to_s

    command = [
      'codesign',
      '--force',
      '--sign', signing_identity,
      '--timestamp=none',
      '--generate-entitlement-der',
    ]
    command += ['--entitlements', entitlements_path] unless entitlements_path.empty?
    command << path

    sh(command.map(&:shellescape).join(' '))
  end

  desc 'Setup code signing for CI builds'
  lane :setup_signing do |options|
    app_id = options[:app_identifier] || 'xyz.depollsoft.monkeyssh.private'
    sync_certs(app_identifier: app_id, type: 'appstore')
  end

  desc 'Force-regenerate provisioning profiles for both bundle IDs and their ' \
       'live activity extensions. Run this after enabling a new App ID ' \
       'capability (e.g. Access WiFi Information) so the new entitlement is ' \
       'baked into the profile stored in the match git repo. Pass type:adhoc ' \
       'to refresh the Firebase App Distribution profiles (e.g. after ' \
       'registering a new tester device).'
  lane :regenerate_profiles do |options|
    schemes = options[:scheme] ? [options[:scheme]] : APP_IDS.keys
    match_type = options[:type] || 'appstore'
    schemes.each do |scheme|
      app_id = APP_IDS[scheme]
      live_activity_app_id = LIVE_ACTIVITY_APP_IDS[scheme]
      UI.user_error!("Unknown scheme '#{scheme}'") unless app_id && live_activity_app_id

      sync_certs(
        app_identifier: [app_id, live_activity_app_id],
        type: match_type,
        readonly: false,
        force: true,
      )
    end
  end

  desc 'Build and sign an IPA without uploading it'
  lane :build_ipa do |options|
    scheme = options[:scheme] || 'Private'
    build_and_sign(scheme: scheme)
  end

  desc 'Re-sign an existing IPA with App Store or ad hoc match profiles'
  lane :resign_ipa do |options|
    scheme = options[:scheme] || 'Private'
    unsigned_ipa_path = options[:unsigned_ipa_path].to_s
    output_ipa_path = options[:output_ipa_path].to_s
    match_type = options[:match_type].to_s
    match_type = 'appstore' if match_type.empty?
    match_readonly = options[:match_readonly].to_s == 'true'
    UI.user_error!("Unsupported match_type '#{match_type}'") unless %w[appstore adhoc].include?(match_type)
    supported_schemes = APP_IDS.keys & LIVE_ACTIVITY_APP_IDS.keys
    unless APP_IDS.key?(scheme) && LIVE_ACTIVITY_APP_IDS.key?(scheme)
      UI.user_error!("Unknown scheme '#{scheme}'. Supported schemes: #{supported_schemes.join(', ')}")
    end
    app_id = APP_IDS[scheme]
    live_activity_app_id = LIVE_ACTIVITY_APP_IDS[scheme]

    UI.user_error!('unsigned_ipa_path is required') if unsigned_ipa_path.empty?
    unsigned_ipa_path = File.expand_path(unsigned_ipa_path)
    output_ipa_path = File.expand_path(output_ipa_path) unless output_ipa_path.empty?
    UI.user_error!("IPA not found at #{unsigned_ipa_path}") unless File.exist?(unsigned_ipa_path)

    sync_certs(
      app_identifier: [app_id, live_activity_app_id],
      type: match_type,
      readonly: match_type == 'appstore' || match_readonly,
      force_for_new_devices: match_type == 'adhoc' && !match_readonly,
    )

    resigned_ipa_path = unsigned_ipa_path
    unless output_ipa_path.empty?
      FileUtils.mkdir_p(File.dirname(output_ipa_path))
      FileUtils.cp(unsigned_ipa_path, output_ipa_path)
      resigned_ipa_path = output_ipa_path
    end

    signing_identity = resolved_certificate_name(
      app_identifier: app_id,
      type: match_type,
    )
    app_profile_path = resolved_profile_path(app_identifier: app_id, type: match_type)
    live_activity_profile_path = resolved_profile_path(
      app_identifier: live_activity_app_id,
      type: match_type,
    )

    Dir.mktmpdir('flutty-resign-ipa') do |tmpdir|
      sh("unzip -q #{resigned_ipa_path.shellescape} -d #{tmpdir.shellescape}")

      payload_dir = File.join(tmpdir, 'Payload')
      app_paths = Dir[File.join(payload_dir, '*.app')].sort
      UI.user_error!("Expected exactly one .app in #{payload_dir}, found #{app_paths.size}") unless app_paths.size == 1
      app_path = app_paths.first

      live_activity_paths = Dir[File.join(app_path, 'PlugIns', 'ConnectionStatusLiveActivityExtension.appex')].sort
      if live_activity_paths.size != 1
        live_activity_paths = Dir[File.join(app_path, 'PlugIns', '*.appex')].sort
      end
      UI.user_error!("Expected exactly one live activity extension in #{app_path}/PlugIns, found #{live_activity_paths.size}") unless live_activity_paths.size == 1
      live_activity_path = live_activity_paths.first

      app_entitlements_path = File.join(tmpdir, 'app-entitlements.plist')
      live_activity_entitlements_path = File.join(tmpdir, 'live-activity-entitlements.plist')

      extract_profile_entitlements(
        profile_path: app_profile_path,
        output_path: app_entitlements_path,
      )
      extract_profile_entitlements(
        profile_path: live_activity_profile_path,
        output_path: live_activity_entitlements_path,
      )

      FileUtils.cp(app_profile_path, File.join(app_path, 'embedded.mobileprovision'))
      FileUtils.cp(live_activity_profile_path, File.join(live_activity_path, 'embedded.mobileprovision'))

      populate_swift_support(
        app_path: app_path,
        package_root: tmpdir,
      )

      codesign_path(
        path: live_activity_path,
        signing_identity: signing_identity,
        entitlements_path: live_activity_entitlements_path,
      )

      Dir[File.join(app_path, 'Frameworks', '*.framework')].sort.each do |framework_path|
        codesign_path(path: framework_path, signing_identity: signing_identity)
      end
      Dir[File.join(app_path, 'Frameworks', '*.dylib')].sort.each do |dylib_path|
        codesign_path(path: dylib_path, signing_identity: signing_identity)
      end
      codesign_path(
        path: app_path,
        signing_identity: signing_identity,
        entitlements_path: app_entitlements_path,
      )

      temporary_ipa_path = "#{resigned_ipa_path}.tmp"
      FileUtils.rm_f(temporary_ipa_path)
      Dir.chdir(tmpdir) do
        package_entries = Dir.children('.').select do |entry|
          File.directory?(entry) && entry != '__MACOSX'
        end
        UI.user_error!('Expected IPA contents to include Payload') unless package_entries.include?('Payload')
        sh("zip -qry #{temporary_ipa_path.shellescape} #{package_entries.map(&:shellescape).join(' ')}")
      end
      FileUtils.rm_f(resigned_ipa_path)
      FileUtils.mv(temporary_ipa_path, resigned_ipa_path)
    end

    resigned_ipa_path
  end

  desc 'Build, sign, and upload to TestFlight'
  lane :beta do |options|
    scheme = options[:scheme] || 'Private'
    app_id = APP_IDS[scheme]
    skip_meta = options[:skip_metadata].to_s == 'true'
    provided_ipa_path = options[:ipa_path].to_s
    changelog, localized_build_info = testflight_release_notes

    build_and_sign(scheme: scheme) if provided_ipa_path.empty?

    followup_path = ENV['FLUTTY_TESTFLIGHT_METADATA_PATH'].to_s
    unless followup_path.empty?
      FileUtils.mkdir_p(File.dirname(followup_path))
      File.write(followup_path, JSON.generate(TestflightDelivery.metadata(
        app_identifier: app_id,
        version: ENV.fetch('FLUTTY_BUILD_NAME'),
        build_number: ENV.fetch('BUILD_NUMBER'),
        changelog: changelog,
        localized_build_info: localized_build_info,
      )))
      pilot(
        api_key: get_api_key,
        app_identifier: app_id,
        ipa: resolved_ipa_path(ipa_path: provided_ipa_path),
        uses_non_exempt_encryption: false,
        **TestflightDelivery.upload_options,
      )
      sync_metadata(app_identifier: app_id, app_version: ENV['FLUTTY_BUILD_NAME']) unless skip_meta
      next
    end

    pilot(
      api_key: get_api_key,
      app_identifier: app_id,
      ipa: resolved_ipa_path(ipa_path: provided_ipa_path),
      skip_waiting_for_build_processing: false,
      skip_submission: false,
      distribute_external: false,
      uses_non_exempt_encryption: false,
      changelog: changelog,
      localized_build_info: localized_build_info,
    )

    sync_metadata(
      app_identifier: app_id,
      app_version: ENV['FLUTTY_BUILD_NAME'],
    ) unless skip_meta
  end

  desc 'Wait for an uploaded build and finish TestFlight distribution without Xcode'
  lane :finish_testflight do |options|
    scheme = options[:scheme] || 'Private'
    data = TestflightDelivery.read(
      options.fetch(:metadata_path),
      app_identifier: APP_IDS.fetch(scheme),
      version: ENV.fetch('FLUTTY_BUILD_NAME'),
      build_number: ENV.fetch('BUILD_NUMBER'),
    )
    api_key = get_api_key
    app = Spaceship::ConnectAPI::App.find(data.fetch(:app_identifier))
    UI.user_error!('TestFlight application was not found') unless app
    require 'fastlane_core/build_watcher'
    processed = FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
      app_id: app.id,
      platform: 'IOS',
      app_version: data.fetch(:app_version),
      build_version: data.fetch(:build_number),
      poll_interval: 30,
      timeout_duration: 1200,
      select_latest: false,
      return_spaceship_testflight_build: false,
      wait_for_build_beta_detail_processing: true,
    )
    # Apple treats 1.2 and 1.2.0 as the same marketing version.
    unless Gem::Version.new(processed.app_version) == Gem::Version.new(data[:app_version]) &&
           processed.version == data[:build_number]
      UI.user_error!('App Store Connect returned a different TestFlight build')
    end
    pilot(
      api_key: api_key,
      distribute_only: true,
      app_platform: 'ios',
      distribute_external: false,
      skip_submission: false,
      uses_non_exempt_encryption: false,
      **data.merge(app_version: processed.app_version),
    )
  end

  desc 'Build, sign with ad hoc profiles, and upload to Firebase App Distribution'
  lane :firebase do |options|
    scheme = options[:scheme] || 'Private'
    provided_ipa_path = options[:ipa_path].to_s
    groups = options[:groups].to_s
    groups = ENV['FIREBASE_TESTER_GROUPS'].to_s if groups.empty?
    UI.user_error!('Set FIREBASE_TESTER_GROUPS or pass groups: to distribute') if groups.empty?

    # Resolve the Firebase app id up front so a misconfigured plist fails in
    # seconds rather than after the archive. Passing :app also avoids the
    # plugin's archive-relative plist lookup, which resolves
    # googleservice_info_plist_path inside the built .app bundle rather than
    # against the source tree.
    flavor_dir = scheme == 'Private' ? 'private' : 'production'
    plist_path = File.expand_path(
      "../Runner/Firebase/#{flavor_dir}/GoogleService-Info.plist",
      __dir__,
    )
    UI.user_error!("Missing Firebase iOS config at #{plist_path}") unless File.exist?(plist_path)

    app_id = sh(
      "/usr/libexec/PlistBuddy -c 'Print :GOOGLE_APP_ID' #{plist_path.shellescape}",
      log: false,
    ).strip
    UI.user_error!("No GOOGLE_APP_ID in #{plist_path}") if app_id.empty?

    build_and_sign(scheme: scheme, export_method: 'ad-hoc') if provided_ipa_path.empty?

    firebase_app_distribution(
      app: app_id,
      ipa_path: resolved_ipa_path(ipa_path: provided_ipa_path),
      groups: groups,
      release_notes: firebase_release_notes,
    )
  end

  desc 'Build, sign, and upload to App Store'
  lane :release do |options|
    scheme = options[:scheme] || 'Production'
    app_id = APP_IDS[scheme]
    skip_meta = options[:skip_metadata].to_s == 'true'
    provided_ipa_path = options[:ipa_path].to_s

    build_and_sign(scheme: scheme) if provided_ipa_path.empty?
    ipa_path = resolved_ipa_path(ipa_path: provided_ipa_path)

    if skip_meta
      deliver(
        api_key: get_api_key,
        app_identifier: app_id,
        app_version: ENV['FLUTTY_BUILD_NAME'],
        ipa: ipa_path,
        skip_metadata: true,
        skip_screenshots: true,
        submit_for_review: true,
        run_precheck_before_submit: false,
        automatic_release: true,
        submission_information: {
          export_compliance_uses_encryption: false,
        },
      )
    else
      sync_metadata(
        app_identifier: app_id,
        app_version: ENV['FLUTTY_BUILD_NAME'],
        ipa_path: ipa_path,
        submit_for_review: true,
        automatic_release: true,
      )
    end
  end

  desc 'Upload metadata, screenshots, previews, and an optional build'
  lane :check_metadata_editable do |options|
    patch_app_store_ready_for_review_lookup
    get_api_key
    app = Spaceship::ConnectAPI::App.find(options[:app_identifier])
    StoreMetadata.editable_version!(app, requested_version: options[:app_version])
  end

  lane :sync_metadata do |options|
    app_id = options[:app_identifier] || 'xyz.depollsoft.monkeyssh'
    app_version = options[:app_version].to_s
    ipa_path = options[:ipa_path].to_s
    submit_for_review = options[:submit_for_review].to_s == 'true'
    automatic_release = options[:automatic_release].to_s == 'true'
    meta_path = METADATA_DIRS[app_id] || './fastlane/metadata-production'

    app_version = check_metadata_editable(app_identifier: app_id, app_version: app_version)
    include_media = StoreMetadata.include_media?(options)

    patch_app_store_ready_for_review_lookup
    patch_deliver_review_attachment_fetch
    patch_deliver_review_information_sync

    review_contact_information = {
      first_name: ENV['APP_REVIEW_CONTACT_FIRST_NAME'],
      last_name: ENV['APP_REVIEW_CONTACT_LAST_NAME'],
      phone_number: ENV['APP_REVIEW_CONTACT_PHONE'],
      email_address: ENV['APP_REVIEW_CONTACT_EMAIL'],
    }.reject { |_key, value| value.to_s.strip.empty? }

    deliver_options = {
      api_key: get_api_key,
      app_identifier: app_id,
      metadata_path: meta_path,
      screenshots_path: SCREENSHOTS_PATH,
      skip_binary_upload: ipa_path.empty?,
      skip_screenshots: !include_media,
      # Clear previously uploaded screenshots and app previews before
      # uploading the current set. Without this, deliver *appends* the new
      # screenshots to whatever is already on App Store Connect, so each sync
      # leaves stale screenshots from older versions behind and the listing
      # ends up with duplicates from different versions.
      overwrite_screenshots: include_media,
      submit_for_review: submit_for_review,
      run_precheck_before_submit: false,
      automatic_release: automatic_release,
      submission_information: {
        export_compliance_uses_encryption: false,
      },
      force: true,
    }
    deliver_options[:app_version] = app_version unless app_version.empty?
    deliver_options[:ipa] = ipa_path unless ipa_path.empty?
    unless review_contact_information.empty?
      deliver_options[:app_review_information] = review_contact_information
    end
    if include_media && Dir.glob(File.join(APP_PREVIEWS_PATH, '**', '*.{mov,mp4,m4v}')).any?
      deliver_options[:app_previews_path] = APP_PREVIEWS_PATH
      deliver_options[:overwrite_preview_videos] = true
    end

    deliver(**deliver_options)
  end
end
