<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The in-app browsers load addresses the user enters: forwarded
         loopback ports and, through a SOCKS forward, services on an SSH
         host's network, which mostly serve plain HTTP under any name or IP.
         WebView refuses cleartext to hosts this config does not permit, and
         domain rules cannot match "any host", so cleartext is allowed
         app-wide. The app's own native traffic is HTTPS. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
